# Choose which AI provider to use: groq | gemini | openrouter
AI_PROVIDER=groq

# Only the key for your chosen provider is required, but you can set all three
# and switch providers anytime by changing AI_PROVIDER above.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

MAX_UPLOAD_SIZE_MB=5
